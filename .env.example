PORT=8090
HOST=0.0.0.0
DATABASE_URL=./data/manager.sqlite
MANAGER_NAME=TowTeam Manager
MANAGER_ADMIN_USERNAME=admin
# Required on first startup. Use at least 12 characters.
MANAGER_ADMIN_PASSWORD=replace-with-a-long-random-password
# Required. Generate with: openssl rand -hex 32
MANAGER_SECRET_KEY=replace-with-64-hex-characters
# Optional fixed public HTTPS origin. Blank accepts the same origin used to open the manager.
PUBLIC_ORIGIN=
TRUST_PROXY=0
# Enable only when this folder is its own Git checkout and Docker or another supervisor restarts it.
MANAGER_UPDATE_ENABLED=false
# Number of nodes updated simultaneously by Update All. Range: 1-10.
BULK_UPDATE_CONCURRENCY=3
